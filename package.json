{
  "name": "espetinho-app",
  "productName": "EspetinhoApp",
  "version": "0.1.0",
  "private": true,
  "main": "main/main.js",
  "author": "RBFraphael",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"NEXT,ELECTRON\" -c \"yellow,blue\" --kill-others \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "next:dev": "next dev",

    "cpPublic:win": "xcopy public .next\\standalone\\EspetinhoApp\\public /E /I /Y",
    "cpDb:win": "mkdir .\\.next\\standalone\\EspetinhoApp\\data >nul 2>&1 & copy /Y data\\db.db .\\.next\\standalone\\EspetinhoApp\\data\\db.db",
    "cpStatic:win": "xcopy .next\\static .next\\standalone\\EspetinhoApp\\.next\\static /E /I /Y",
    "cp:all:win": "npm run cpPublic:win && npm run cpStatic:win && npm run cpDb:win",

    "next:build": "next build && npm run cp:all:win",
    "next:start": "node .next/standalone/EspetinhoApp/server.js",
    "lint": "eslint",
    "rebuild": "electron-rebuild",
    "comando:antigo": "next start",

    "start:electron": "electron .",
    "pack": "npm run next:build && electron-packager . EspetinhoApp --platform=win32 --arch=x64 --out=dist --overwrite",
    
    "build:win": "next build && npm run rebuild && electron-builder --win --x64",
    "postinstall": "npx electron-rebuild -f -w sqlite3 --version 38.2.1"

    


  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tabler/icons-react": "^3.35.0",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.0",
    "heroicons": "^2.2.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.4",
    "sqlite3": "^5.1.7",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.1"
  }
}
