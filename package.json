{
  "name": "espetinho-app",
  "productName": "EspetinhoApp",
  "version": "0.1.0",
  "private": true,
  "main": "main/main.js",
  "author": "RBFraphael",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"NEXT,ELECTRON\" -c \"yellow,blue\" --kill-others \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "start": "next start",
    "lint": "eslint",
    "rebuild": "electron-rebuild",

    "build:next": "next build",
    "start:electron": "electron .",
    "pack": "npm run build:next && electron-packager . EspetinhoApp --platform=win32 --arch=x64 --out=dist --overwrite",
    
    "build:win": "next build && npm run rebuild && electron-builder --win --x64",
    "postinstall": "npx electron-rebuild -f -w sqlite3 --version 38.2.1"

    


  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tabler/icons-react": "^3.35.0",
    "clsx": "^2.1.1",
    "electron-serve": "^3.0.0",
    "heroicons": "^2.2.0",
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.4",
    "sqlite3": "^5.1.7",
    "use-debounce": "^10.0.6",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.0.1"
  }
}
